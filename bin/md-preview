#!/bin/bash
# md-preview — hints target (⌘⇧M): render the picked path in-terminal.
# Markdown gets glow's pager; anything else falls back to less.
# hints hands text over verbatim, gluing prose around real paths:
# "(...path.md)" and tool-call renders like "Update(~/path/file.md)".
# MD_PREVIEW_FROM_HEADING starts Markdown at that heading; absent headings
# fall back to the whole document. Keep the original path for relative images.
resolve() {
    local x="${1/#\~/$HOME}"
    while [ ! -e "$x" ]; do
        case "$x" in
            *")"|*"]"|*"}"|*","|*"."|*":"|*";"|*"'"|*'"') x="${x%?}" ;;
            *) break ;;
        esac
    done
    printf '%s' "$x"
}
f=$(resolve "$1")
if [ ! -e "$f" ]; then
    case "$1" in *"("*) f=$(resolve "${1##*\(}") ;; esac
fi
[ -e "$f" ] || { echo "not a file here: $f"; sleep 1.5; exit 1; }
GLOW="$(command -v glow || echo /opt/homebrew/bin/glow)"
case "$f" in
    *.md|*.markdown|*.mdx)
        mdv_args=()
        if [ -n "${MD_PREVIEW_FROM_HEADING:-}" ]; then
            mdv_args=(--from-heading "$MD_PREVIEW_FROM_HEADING")
            if [ -t 1 ]; then
                # Keep the heading visible even when its suffix fills scrollback.
                "$(dirname "${BASH_SOURCE[0]}")/mdv" "${mdv_args[@]}" "$f" | less -R +0
                exit $?
            fi
        fi
        "$(dirname "${BASH_SOURCE[0]}")/mdv" "${mdv_args[@]}" "$f"
        if [ -d "/Applications/SMD.app" ]; then
            printf '\n\033[38;2;107;115;148m— o opens in SMD · any other key closes (wheel scrolls) —\033[0m'
            IFS= read -rsn1 k
            [ "$k" = "o" ] && /usr/bin/open -a SMD "$f"
        else
            printf '\n\033[38;2;107;115;148m— any key to close (wheel scrolls) —\033[0m'
            IFS= read -rsn1
        fi
        exit 0 ;;
    *) exec /usr/bin/less -R "$f" ;;
esac
