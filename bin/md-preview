#!/bin/bash
# md-preview — hints target (⌘⇧M): render the picked path in-terminal.
# Markdown gets glow's pager; anything else falls back to less.
# hints hands text over verbatim, gluing prose around real paths:
# "(...path.md)" and tool-call renders like "Update(~/path/file.md)".
resolve() {
    local x="${1/#\~/$HOME}"
    while [ ! -e "$x" ]; do
        case "$x" in
            *")"|*"]"|*"}"|*","|*"."|*":"|*";"|*"'"|*'"') x="${x%?}" ;;
            *) break ;;
        esac
    done
    printf '%s' "$x"
}
f=$(resolve "$1")
if [ ! -e "$f" ]; then
    case "$1" in *"("*) f=$(resolve "${1##*\(}") ;; esac
fi
[ -e "$f" ] || { echo "not a file here: $f"; sleep 1.5; exit 1; }
GLOW="$(command -v glow || echo /opt/homebrew/bin/glow)"
case "$f" in
    *.md|*.markdown|*.mdx)
        "$HOME/Documents/GlowDevelopment/nekotron/bin/mdv" "$f"
        printf '\n\033[38;2;107;115;148m— any key to close (wheel scrolls) —\033[0m'
        IFS= read -rsn1
        exit 0 ;;
    *) exec /usr/bin/less -R "$f" ;;
esac
