#!/usr/bin/env python3
"""Open the other laptop's terminals as native kitty tabs."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'kitty'))
import fleet_remote

if __name__ == '__main__':
    try:
        fleet_remote.main()
    except (KeyboardInterrupt, EOFError):
        pass
    except Exception as e:
        print(f'fleet-remote: {e}', file=sys.stderr)
        if not any(a in sys.argv for a in ('--session-tab', '--unshared-tab', '--error-tab')):
            fleet_remote.show_error(str(e))
        sys.exit(1)
