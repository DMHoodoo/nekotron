#!/usr/bin/env python3
"""mdv — full-fat markdown view for kitty.

glow renders the text (Nekotron style), kitty's icat draws ![images]()
inline, and ```mermaid fences render to real diagrams via mmdc when it
is installed (styled code block fallback otherwise). Output scrolls in
normal kitty scrollback — no pager, images scroll with the text.

  mdv file.md
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

STYLE = os.path.expanduser("~/Documents/GlowDevelopment/nekotron/glow/nekotron.json")
GLOW = shutil.which("glow") or "/opt/homebrew/bin/glow"
KITTEN = shutil.which("kitten") or "/Applications/kitty.app/Contents/MacOS/kitten"
MMDC = shutil.which("mmdc") or "/opt/homebrew/bin/mmdc"
DIM, RST = "\033[38;2;107;115;148m", "\033[0m"

IMG = re.compile(r"^\s*!\[([^\]]*)\]\(([^)]+)\)\s*$")


def glow_text(md, width):
    if not md.strip():
        return
    env = dict(os.environ, CLICOLOR_FORCE="1")
    subprocess.run([GLOW, "-s", STYLE, "-w", str(width), "-"],
                   input=md, text=True, env=env)


def show_image(path, alt):
    if os.environ.get("KITTY_WINDOW_ID") and os.path.exists(KITTEN):
        r = subprocess.run([KITTEN, "icat", "--align", "left", path])
        if r.returncode == 0:
            if alt:
                print(f"  {DIM}{alt}{RST}\n")
            return
    print(f"  {DIM}[image: {alt or os.path.basename(path)}]{RST}\n")


def show_mermaid(code, width):
    if os.path.exists(MMDC) or shutil.which("mmdc"):
        with tempfile.TemporaryDirectory() as td:
            src = os.path.join(td, "d.mmd")
            out = os.path.join(td, "d.png")
            open(src, "w").write(code)
            r = subprocess.run([MMDC, "-i", src, "-o", out, "-t", "dark",
                                "-b", "transparent", "-q", "--scale", "2"],
                               capture_output=True, text=True, timeout=60)
            if r.returncode == 0 and os.path.exists(out):
                show_image(out, "")
                return
    glow_text(f"```\n{code}```\n", width)  # fallback: styled code block


def main():
    if len(sys.argv) < 2 or not os.path.isfile(sys.argv[1]):
        print(__doc__.strip().splitlines()[-1].strip())
        sys.exit(1)
    doc = sys.argv[1]
    base = os.path.dirname(os.path.abspath(doc))
    width = min(110, shutil.get_terminal_size((100, 40)).columns - 2)

    buf = []
    lines = open(doc).read().splitlines(keepends=True)
    i = 0
    while i < len(lines):
        line = lines[i]
        m = IMG.match(line)
        if m and not m.group(2).startswith(("http://", "https://")):
            glow_text("".join(buf), width)
            buf = []
            p = m.group(2)
            show_image(p if os.path.isabs(p) else os.path.join(base, p), m.group(1))
            i += 1
            continue
        if line.strip().startswith("```mermaid"):
            glow_text("".join(buf), width)
            buf = []
            code = []
            i += 1
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            i += 1  # closing fence
            show_mermaid("".join(code), width)
            continue
        buf.append(line)
        i += 1
    glow_text("".join(buf), width)


if __name__ == "__main__":
    main()
