#!/bin/bash
# kitty-to-orca — migration manifest: every live Claude/Codex session as a
# ready-to-run resume command for Orca panes (or any other host).
# Sessions are portable (transcript + cwd); the PROCESS must be re-launched
# by the new host. Close the kitty tab BEFORE resuming the same session id
# elsewhere — one session, one live process.
echo "# Nekotron fleet → Orca migration manifest  ($(date '+%Y-%m-%d %H:%M'))"
echo "# For each session: in Orca, new pane in the listed directory, run the command."
echo "# Close its kitty tab first (q or ⌘W) to avoid double-resume."
echo
for f in "$HOME"/.claude/sessions/*.json; do
    [ -f "$f" ] || continue
    pid=$(basename "$f" .json)
    kill -0 "$pid" 2>/dev/null || continue
    ps -p "$pid" -o command= | /usr/bin/grep -q "bg-spare" && continue
    /usr/bin/python3 - "$f" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
sid, cwd = d.get("sessionId", ""), d.get("cwd", "")
if sid and cwd and "/T" not in cwd:
    print(f"## {cwd}")
    print(f"cd {cwd} && claude --resume {sid}")
    print()
PY
done
echo "# Codex sessions: Orca already backfills ~/.codex/sessions natively."
echo "# tmux-hosted sessions survive anywhere: 'tmux attach -t <name>' in any pane."
tmux ls 2>/dev/null | sed 's/^/# tmux: /'
