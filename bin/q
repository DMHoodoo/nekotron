#!/bin/bash
# q — quick LOCAL-model answer (ollama gemma4, direct). ~6s warm, free.
# Pipe context in:  cat err.log | q what broke
# For an AGENTIC local ask (tools, file access) use qa (crush lane).
[ $# -gt 0 ] || { echo "usage: q <question>   (stdin becomes context)"; exit 1; }
OLLAMA="$(command -v ollama || echo /usr/local/bin/ollama)"
# keep the model pinned so the next q stays warm (ollama evicts after 5 min)
(/usr/bin/curl -s --max-time 2 http://localhost:11434/api/generate \
    -d '{"model":"gemma4:latest","keep_alive":"24h"}' >/dev/null 2>&1 &)
prompt="$*"
[ -t 0 ] || prompt="$(cat)

$prompt"
# always hand the prompt over stdin: ollama run ignores the arg when stdin
# is not a tty, so the arg form breaks piped and scripted use.
# On a tty, typeset the (markdown) answer through glow.
GLOW="$(command -v glow || echo /opt/homebrew/bin/glow)"
STYLE="$HOME/Documents/GlowDevelopment/nekotron/glow/nekotron.json"
if [ -t 1 ] && [ -x "$GLOW" ]; then
    printf '%s' "$prompt" | "$OLLAMA" run --think=false gemma4:latest \
        | /usr/bin/perl -pe 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/\r//g' \
        | CLICOLOR_FORCE=1 "$GLOW" -s "$STYLE" -w $(( $(tput cols 2>/dev/null || echo 100) - 4 )) -
else
    printf '%s' "$prompt" | "$OLLAMA" run --think=false gemma4:latest
fi
