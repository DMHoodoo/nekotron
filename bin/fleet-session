#!/usr/bin/env python3
"""Run a persistent command or attach to it from another terminal."""
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'kitty'))
import fleet_tmux


def main():
    args = sys.argv[1:]
    if args == ['list']:
        for s in fleet_tmux.sessions().values():
            print(f"{s['name']}\t{s['command']}\t{s['cwd']}")
    elif args == ['list', '--json']:
        print(json.dumps(fleet_tmux.sessions()))
    elif len(args) == 2 and args[0] == 'attach':
        fleet_tmux.attach(args[1])
    elif args and args[0] == 'run' and len(args) > 1:
        command = args[1:]
        if command[0] == '--':
            command = command[1:]
        if not command:
            raise ValueError('a command is required')
        if os.environ.get('TMUX') or not (sys.stdin.isatty() and sys.stdout.isatty()):
            os.execvp(command[0], command)
        name = fleet_tmux.start(command)
        print(f'Shared session: {name} — Ctrl-B then D detaches without stopping it.', flush=True)
        fleet_tmux.attach(name)
    else:
        raise ValueError('usage: fleet-session run COMMAND [ARGS...] | attach NAME | list [--json]')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, __import__('subprocess').SubprocessError) as e:
        print(f'fleet-session: {e}', file=sys.stderr)
        sys.exit(1)
